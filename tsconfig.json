{
  // The harness is plain ESM JavaScript with JSDoc types; tsc checks it like TypeScript.
  "extends": "./config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["bin/**/*.mjs", "lib/**/*.mjs", "config/**/*.mjs", "evals/**/*.mjs", "test/**/*.mjs", "eslint.config.mjs"],
  "exclude": ["node_modules", "templates"]
}
