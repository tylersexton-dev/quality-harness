{
  "name": "quality-harness",
  "version": "0.1.0",
  "description": "Make agent-written TypeScript trustworthy: strict types, strict lint, a ratchet for old code, a Claude Code hook, and a PR check.",
  "type": "module",
  "license": "MIT",
  "author": "Tyler Sexton",
  "repository": "github:tylersexton-dev/quality-harness",
  "bin": {
    "harness": "bin/harness.mjs"
  },
  "exports": {
    "./eslint": "./config/eslint.mjs",
    "./config/tsconfig.base.json": "./config/tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "config",
    "templates"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
